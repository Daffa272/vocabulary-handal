{
  "installCommand": "npm --prefix voice-studio install",
  "buildCommand": "npm --prefix voice-studio run build && node scripts/prepare-vercel-output.mjs",
  "outputDirectory": "vercel-output",
  "functions": {
    "api/tts.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/voice-studio",
      "destination": "/voice-studio/index.html"
    }
  ]
}
